# Cloudways / Apache — Flutter Web SPA
# ไฟล์นี้จะถูกคัดลอกไปยัง build/web ตอน flutter build web
# (สคริปต์ deploy จะคัดลอกซ้ำอีกครั้งเพื่อความชัวร์)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # บังคับ HTTPS (เปิดใช้เมื่อมี SSL บนโดเมนแล้ว)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ไม่ rewrite ไฟล์/โฟลเดอร์ที่มีอยู่จริง (js, wasm, assets, icons)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# MIME ที่จำเป็นสำหรับ Flutter Web
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/wasm .wasm
  AddType application/json .json
  AddType text/cache-manifest .appcache
</IfModule>

# แคช asset ที่ hash แล้วให้นาน / index กับ service worker ไม่แคชนาน
<IfModule mod_headers.c>
  <FilesMatch "\.(js|wasm|png|jpg|jpeg|gif|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|flutter_service_worker\.js|flutter_bootstrap\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
