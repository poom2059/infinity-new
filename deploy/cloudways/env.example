# คัดลอกเป็น .env บนเซิร์ฟเวอร์ Cloudways (Application → Environment Variables)
# หรือใส่ในไฟล์ที่ process manager โหลดตอน start

# พอร์ต — Cloudways Node จะกำหนด PORT ให้เอง มักไม่ต้องแก้
PORT=3000
HOST=0.0.0.0

# เสิร์ฟไฟล์ Flutter จาก server/public (หลังรันสคริปต์ build)
SERVE_WEB=true
WEB_ROOT=

# ที่เก็บ SQLite — ชี้ไปโฟลเดอร์ที่ไม่วิ่งทับตอน deploy (แนะนำ)
# ตัวอย่าง: /home/master/applications/<APP_ID>/private_html/data/infinity.sqlite
DB_PATH=

# จำกัด CORS ให้เหลือโดเมนเว็บจริง (คั่นด้วย comma ถ้ามีหลายโดเมน)
# ถ้าเว็บกับ API โดเมนเดียวกัน ใส่โดเมนนั้น หรือปล่อยว่างได้
CORS_ORIGIN=https://YOUR_APP.cloudwaysapps.com
