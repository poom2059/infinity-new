{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: run web (Chrome)",
      "type": "shell",
      "command": "\"${workspaceFolder}\\run_web.bat\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "${env:windir}\\System32\\cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
